# Maintainer: LowBloat <contato@fabioharaujo.com.br>
pkgname=lownotes-bin
pkgver=0.3.4
pkgrel=1
pkgdesc="Local-first Markdown notes with serverless P2P sync and real-time collaboration"
arch=('x86_64')
url="https://github.com/LowBloat/LowNotes"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator-gtk3' 'dbus')
provides=('lownotes')
conflicts=('lownotes')
options=('!strip')
source=(
    "lownotes-${pkgver}.tar.gz::https://github.com/LowBloat/LowNotes/releases/download/v${pkgver}/LowNotes-${pkgver}-linux-x64-portable.tar.gz"
    "lownotes.desktop"
    "lownotes.png::https://raw.githubusercontent.com/LowBloat/LowNotes/v${pkgver}/src-tauri/icons/128x128.png"
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    install -Dm755 "${srcdir}/LowNotes" "${pkgdir}/usr/bin/lownotes"
    install -Dm644 "${srcdir}/lownotes.desktop" "${pkgdir}/usr/share/applications/lownotes.desktop"
    install -Dm644 "${srcdir}/lownotes.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/lownotes.png"
}
