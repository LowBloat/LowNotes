{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LowNotes",
  "version": "0.4.0",
  "identifier": "dev.lowbloat.lownotes",
  "build": {
    "beforeDevCommand": "bun run icons && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run icons && bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "LowNotes",
        "maximized": true,
        "width": 1100,
        "height": 750,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost lownotes-image: http://lownotes-image.localhost data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "LowBloat",
    "copyright": "Copyright © 2026 LowBloat. Licensed under AGPL-3.0-only.",
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes with P2P sync",
    "longDescription": "LowNotes keeps Markdown notes in a folder you choose, syncs paired devices directly over encrypted P2P connections, supports real-time collaborative editing and offers an optional assistant with local or remote AI providers.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LowBloat/LowNotes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNzNGMzkzRTk3M0JEMgpSV1RTTzVjK09UOG5BeThpcHZvZmF3UVltRDJmR0t2WjNrazdsUEt1blJrNWJPY2FwNUNUMmJYcgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
